    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
